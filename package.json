{
  "name": "leftoff",
  "version": "0.1.0",
  "private": true,
  "description": "Pick up any project in seconds: a desktop app that shows where you left off, written by Claude Code for a few hundred tokens a session",
  "keywords": [
    "adhd",
    "claude-code",
    "project-tracker",
    "token-efficient",
    "productivity",
    "electron"
  ],
  "license": "MIT",
  "repository": "github:Geanyl17/leftoff",
  "main": "./out/main/index.js",
  "author": "Geanyl",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "icon": "node scripts/make-icon.mjs",
    "dump": "electron-vite build && LEFTOFF_DUMP=1 electron .",
    "setup": "electron-vite build && ./bin/leftoff setup",
    "demo": "node scripts/demo-data.mjs leftoff-demo && XDG_CONFIG_HOME=\"$PWD/leftoff-demo/config\" electron-vite preview"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.0.0",
    "electron-vite": "^3.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
